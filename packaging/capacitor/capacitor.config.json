{
  "_comment": "תצורת Capacitor לאנדרואיד ול-iOS. server.url מצביע על השרת שלכם, כי ה-API והמסד נמצאים בו. YOUR-DOMAIN הוא placeholder.",
  "appId": "il.coach.app",
  "appName": "מאמן אישי",
  "webDir": "../../public",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://YOUR-DOMAIN",
    "cleartext": false,
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0b0e14"
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0b0e14",
    "limitsNavigationsToAppBoundDomains": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#0b0e14",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0b0e14",
      "overlaysWebView": true
    }
  }
}
