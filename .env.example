# ==========================================================
# קובץ משתני סביבה לדוגמה - אין לשמור בו סודות אמיתיים
# העתיקו ל-.env מקומי:  cp .env.example .env
# ==========================================================

# --- שרת ---
PORT=3000
NODE_ENV=development

# מאחורי reverse proxy (nginx/Caddy): 1 כדי שהגבלת הקצב תזהה את כתובת המשתמש האמיתית.
# אין להפעיל כשהשרת חשוף ישירות - אפשר לזייף את הכותרת.
TRUST_PROXY=0

# סוד לחתימת עוגיות סשן. חייב להיות ייחודי וסודי בייצור.
# יצירת מפתח:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production-32-bytes-min

# --- כניסה מהירה (שם חופשי + קוד גישה משותף) ---
# QUICK_ACCESS=on  -> מסך הכניסה מציע "כניסה מהירה": כל שם + הקוד שלמטה.
# QUICK_ACCESS=off -> רק חשבון עם אימייל וסיסמה.
#
# אזהרה: הקוד משותף לכל המשתמשים, ולכן מי שמכיר אותו יכול להיכנס בכל שם -
# כולל שם שמישהו אחר השתמש בו. מתאים לקבוצה שסומכת זה על זה, לא לשימוש ציבורי.
QUICK_ACCESS=on
# חובה למלא כדי שהכניסה המהירה תעבוד. בלי ערך כאן - המסלול כבוי,
# והאפליקציה תעבוד רק עם חשבון אימייל וסיסמה.
# אל תכתבו כאן קוד אמיתי אם המאגר ציבורי: זה קובץ שנכנס לגיט.
ACCESS_CODE=

# --- מסד נתונים ---
# sqlite - קובץ מקומי. פיתוח, בדיקות, ושרת עם דיסק מתמיד.
# turso  - SQLite מנוהל מעל HTTP. לאירוח בלי דיסק מתמיד (למשל Render בתוכנית החינמית).
# שני הדרייברים מקבלים את אותו SQL ואותן מיגרציות.
DB_DRIVER=sqlite
SQLITE_PATH=./data/coach.db

# להרצה מול Turso:
#   DB_DRIVER=turso
#   TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
#   TURSO_AUTH_TOKEN=<טוקן מלוח הבקרה של Turso>
#   DB_TIMEOUT_MS=15000
# הטוקן הוא סוד: בפריסה מגדירים אותו אצל המארח, לא בקובץ שנכנס לגיט.

# --- שכבת AI (אופציונלית לחלוטין) ---
# AI_PROVIDER=none      -> הסברים דטרמיניסטיים מקומיים (ברירת מחדל, ללא עלות ובלי רשת)
# AI_PROVIDER=anthropic -> דורש ANTHROPIC_API_KEY
# AI_PROVIDER=openai    -> דורש OPENAI_API_KEY
# המערכת חייבת לעבוד במלואה גם כאשר AI_PROVIDER=none או כשהשירות נפל.
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=15000

# --- מדיה (סרטוני הדגמה) ---
# בסיס URL לנכסי מדיה בבעלותכם או ברישיון מתאים.
# ריק = האפליקציה תציג הוראות כתובות במקום נגן. אין קישורים מומצאים בקוד.
MEDIA_BASE_URL=

# --- מנהל ראשוני ---
# נוצר על ידי npm run seed, וגם אוטומטית בעלייה הראשונה אם אין עוד חשבון מנהל.
# האתחול האוטומטי נדרש באירוח חינמי שאין בו גישת shell להרצת seed.
# אחרי ההתחברות הראשונה יש לשנות את הסיסמה.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin!2345
